{
  "name": "@tessel-la/roboboy-hello-panel",
  "version": "1.0.0",
  "description": "Minimal standalone external panel for Robo-Boy",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "roboboy.panel.json",
    "README.md"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "integrity": "node scripts/print-integrity.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "validate": "npm run typecheck && npm run validate:artifact"
  },
  "devDependencies": {
    "@tessel-la/roboboy-panel-sdk": "https://github.com/tessel-la/robo-boy/releases/download/panel-sdk-v1.0.0/tessel-la-roboboy-panel-sdk-1.0.0.tgz",
    "typescript": "^5.2.2"
  }
}
